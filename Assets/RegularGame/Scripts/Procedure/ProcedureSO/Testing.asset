    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: fc4bc5ee9c98f74488ed456d4e823f63, type: 2}
      amountRequired: 1
  - description: Secure the propellers using lock nuts
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: 705ef80dc2946cc478aa2c5be6e4cb68, type: 2}
      amountRequired: 1
  - description: Attach the Pixhawk mounting plate to the drone body
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: be72f47e79d391440b961303f5aa1047, type: 2}
      amountRequired: 1
  - description: Secure the Pixhawk mounting plate with screws
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: 082b71a620b1d454db14f0efda346e11, type: 2}
      amountRequired: 1
  - description: Attach the base plate to the Pixhawk plate
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: 6cebfcafc5cc8204b812e83af74db9f6, type: 2}
      amountRequired: 1
  - description: Secure the base plate with screws
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: c00fa2d1fd21151459fae762f3ccc844, type: 2}
      amountRequired: 1
  - description: Attach the upper plate to the base plate
