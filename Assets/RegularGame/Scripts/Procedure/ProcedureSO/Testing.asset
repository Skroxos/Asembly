  procedureName: Drone Assembly
  steps:
  - description: Prepare screws for the motor mounts
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: ef88ed58b37e6b946a517f58b31ad853, type: 2}
      amountRequired: 1
  - description: Attach motor mounts and stands to the drone body
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: d7028c0a20da7a940bb54bb3a803af9d, type: 2}
      amountRequired: 1
