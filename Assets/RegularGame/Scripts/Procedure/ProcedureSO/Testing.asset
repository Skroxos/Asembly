      amountRequired: 1
  - description: Attach the second drone body plate
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: 45143466566bfdc42a2c5db304d9e984, type: 2}
      amountRequired: 1
  - description: Secure the stands with screws and attach the motor bells
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: 082b71a620b1d454db14f0efda346e11, type: 2}
      amountRequired: 1
    - requiredPartID: {fileID: 11400000, guid: 0b1575f200e0dae4f9efa22364a89b37, type: 2}
      amountRequired: 1
