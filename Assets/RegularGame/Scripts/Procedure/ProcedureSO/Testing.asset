    - requiredPartID: {fileID: 11400000, guid: 906304ab170a8304d9d759ef74b00d40, type: 2}
      amountRequired: 1
  - description: Mount the Pixhawk flight controller to the upper plate
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: 912a4eab1fb680648a455a8777b81399, type: 2}
      amountRequired: 1
  - description: Attach the top mounting plate and batery plate to the drone
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: de1f3bf5b73b66040b761830e4f6d95b, type: 2}
      amountRequired: 1
    - requiredPartID: {fileID: 11400000, guid: 91e2cc9b7b261794aa54343bf5e97e26, type: 2}
      amountRequired: 1
  - description: Secure the top plate with screws
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: c00fa2d1fd21151459fae762f3ccc844, type: 2}
      amountRequired: 1
  - description: Attach the circuit board and the battery
    requiredParts:
    - requiredPartID: {fileID: 11400000, guid: f43484eae230f514f8c1a74d59705ab5, type: 2}
      amountRequired: 1
